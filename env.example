# Copie este arquivo para ".env" e ajuste. O ".env" NÃO deve ser commitado.
# Comentários ficam em linhas próprias (nunca no fim da linha de um valor).

# =============================== CAMINHOS ===============================
# Relativos à raiz do projeto (ou absolutos).

# Pasta(s) com as imagens a processar. Aceita uma pasta ou várias, separadas por vírgula.
# Com várias, cada uma gera uma subpasta de saída própria (ex.: saidas/car-br).
PASTA_IMAGENS=datasetConvertidoYOLO/car-br/images/test
# Exemplo com as 4 pastas de teste do dataset convertido:
# PASTA_IMAGENS=datasetConvertidoYOLO/car-br/images/test,datasetConvertidoYOLO/car-me/images/test,datasetConvertidoYOLO/moto-br/images/test,datasetConvertidoYOLO/moto-me/images/test

# Onde gravar resultados, mosaicos e eventos (não é versionada).
PASTA_SAIDA=saidas
# Dataset convertido com os split_manifest.csv (usado por comprovacaoAcertos.py).
PASTA_DATASET=datasetConvertidoYOLO
# Pesos do detector de placas (YOLO de 4 classes). Usado quando DETECTOR=ultralytics.
CAMINHO_MODELO_YOLO=modelos/modelo4classesV1/best.pt

# Qual detector usar: p2 (pacote do B5 carregado pela biblioteca P2, recomendado) | ultralytics (best.pt).
# Em 200 imagens (50 por pasta) os dois acertaram 167 (83,5%); o P2 levou 1 min 55 s contra 3 min 59 s.
# Fora do Docker, DETECTOR=p2 exige o P2 instalado e o engine compilado (ver README); no Docker já vem pronto.
DETECTOR=p2
# Engine do P2 (<artifact_id>-<artifact_version> do pacote do B5). Usado quando DETECTOR=p2.
# No Docker o engine é compilado na construção da imagem (pasta modelos/app-plates-1.0.0).
P2_ENGINE_REF=app-plates-1.0.0

# ===================== CONFIGURAÇÃO DO PIPELINE =====================
# Valores da configuração vencedora (800 imagens de teste: 84,0% corretas).

# Modelo de OCR. O padrão do código é o antigo (global-plates-mobile-vit-v2-model).
OCR_MODELO=cct-s-v2-global-model
# Pré-processamento do recorte antes do OCR (sim | nao).
PREPROCESSAMENTO=sim
# Margem extra ao redor da placa, em % do tamanho da caixa.
MARGEM_RECORTE_PCT=0
# Margem só para placas Mercosul (sobrescreve a de cima nessas classes).
MARGEM_RECORTE_MERCOSUL_PCT=10
# Placa de 2 linhas (motos): nao | auto | fixo (dobra em uma linha larga) | separar (lê cada linha sozinha
# e junta os textos; usa o mesmo corte automático). "nao" foi o melhor até agora com este OCR.
DOBRAR_2L=nao
# Ampliação do recorte antes do OCR: 0 = regra original (dobra o tamanho se o recorte for pequeno);
# um valor amplia o recorte até essa altura em pixels, mantendo a proporção (nunca reduz).
# Recomendado: 160 (com PRE_PROPORCAO=2 melhorou as motos de 71,8% para 75,5% em 400 imagens; carros iguais).
PRE_ALTURA_ALVO=160
# Realce de nitidez depois do filtro (0 = desligado; valores típicos: 0.5 a 1.5).
PRE_NITIDEZ=0
# Proporção do recorte (largura/altura) esperada pelo OCR. 0 = desligado. Com um valor (ex.: 2), recortes
# mais "quadrados" ganham bordas laterais até chegar nessa proporção, em vez de serem esticados.
# Recomendado: 2 (não altera carros, que já são largos).
PRE_PROPORCAO=2

# ==================== PUBLICAÇÃO DE EVENTOS ====================
# arquivo = grava eventos.jsonl (sem rede) | kafka = envia ao broker | desligado = não gera eventos.
# O padrão seguro é "arquivo": só use "kafka" quando quiser mesmo publicar no broker compartilhado,
# e com poucas imagens (-n 2), para não gastar os créditos do projeto.
PUBLICACAO_MODO=arquivo
# Câmera/portão de origem dos eventos.
SOURCE_ID=cam-entrada
# Versão do artefato nos eventos. Padrão: <pasta do modelo YOLO>+<modelo de OCR sem "-model">.
# ARTIFACT_VERSION=modelo4classesV1+cct-s-v2-global
# Se a menor confiança entre os 7 caracteres ficar abaixo deste valor, o evento sai com uncertain=true.
LIMIAR_INCERTEZA=0.9

# ---------------------------- Kafka ----------------------------
# Só valem com PUBLICACAO_MODO=kafka (e para scripts/consumidor_teste.py).
# Nome do tópico = campo "schema" dos eventos.
KAFKA_TOPICO=ods.i7.plate_read
# Endereço do broker (temporário, na nuvem; na versão final será local).
KAFKA_BROKER=34.66.235.91:9093
